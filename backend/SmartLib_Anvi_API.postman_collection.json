              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rohan Mehta\",\n  \"studentId\": \"241102\",\n  \"email\": \"rohan.mehta@university.edu\",\n  \"department\": \"ECE\",\n  \"year\": \"2nd Year\",\n  \"password\": \"RohanPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/students",
              "host": ["{{baseUrl}}"],
              "path": ["users", "students"]
            },
            "description": "Admin creates a student account."
          },
          "response": []
        },
        {
          "name": "Admin Delete Student",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "x-admin-secret",
                "value": "{{adminSecret}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{studentId}}"]
            },
            "description": "Deletes a student account."
          },
          "response": []
        },
        {
          "name": "[Negative] Delete Student Without Auth (Expect 401)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{studentId}}"]
            },
            "description": "Expects 401 Unauthorized."
          },
          "response": []
        }
      ]
    }
  ]
}