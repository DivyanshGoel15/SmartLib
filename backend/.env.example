# Server Configuration
PORT=5000

# MongoDB Atlas Connection URI
# Either MONGO_URI or MONGODB_URI is supported
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smartlib?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smartlib?retryWrites=true&w=majority

# Comma-separated trusted CORS origins; use exact origins in production
CLIENT_ORIGIN=https://your-frontend.example.com

# Administrative Security Key (used for privileged server-side admin setup/operations)
ADMIN_SECRET=<your_secure_admin_secret>

# JWT Session Secret (used to cryptographically sign session tokens)
JWT_SECRET=<your_secure_jwt_secret>

# Separate code distributed only through the approved faculty onboarding process
FACULTY_REGISTRATION_SECRET=<your_faculty_onboarding_secret>

# Initial administrator account provisioning (requires explicit CLI confirmation)
INITIAL_ADMIN_EMAIL=<initial_admin_email>
INITIAL_ADMIN_PASSWORD=<unique_password_at_least_12_characters>
INITIAL_ADMIN_NAME=SmartLib Administrator

# Dedicated database for scripts/tests that create records; database name must be smartlib_test
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/smartlib_test
